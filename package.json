{
  "name": "GarageLedger",
  "private": true,
  "version": "1.8.3",
  "type": "module",
  "description": "Quiet-luxury, offline-first garage inventory and financial analytics desktop app.",
  "author": "Mikail",
  "repository": {
    "type": "git",
    "url": "https://github.com/RealMrNovember/GarageLedger.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:electron:dev\"",
    "electron:dev": "npm run icons && node tools/patch-electron-icon.mjs && wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "icons": "node tools/generate-icon.mjs && node tools/sync-animation-assets.mjs",
    "sync-assets": "node tools/sync-animation-assets.mjs",
    "installer-assets": "node tools/sync-animation-assets.mjs && node tools/generate-installer-assets.mjs",
    "build": "tsc -b && vite build",
    "verify:release": "node tools/verify-release.mjs",
    "verify:release:build": "node tools/verify-release.mjs --build",
    "verify:win7": "node tools/verify-win7.mjs",
    "predist": "npm run verify:release",
    "dist": "npm run icons && npm run installer-assets && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis",
    "publish": "npm run icons && npm run installer-assets && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --publish always",
    "release:publish": "npm run publish",
    "release": "npm run verify:release && npm version minor && git push --follow-tags && npm run publish",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "i18next": "^26.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lowdb": "^7.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.7",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "22.3.27",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.14",
    "rcedit": "^5.0.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "build": {
    "icon": "build/icon.ico",
    "appId": "com.cicibyte.garageledger",
    "productName": "GarageLedger",
    "directories": {
      "output": "release-build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "electron/splash/**",
      "build/icon.ico",
      "build/icon.png",
      "releases.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/installer/wizard.gif",
        "to": "installer/wizard.gif"
      },
      "../prompt.md",
      "README.md"
    ],
    "asar": true,
    "afterPack": "tools/after-pack-win-icon.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "executableName": "GarageLedger",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "artifactName": "GarageLedger.Setup.${version}.${arch}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "guid": "7c4e9a2b-8f3d-4a1e-9c6b-2d8f5e1a0b3c",
      "artifactName": "GarageLedger.Setup.${version}.${arch}.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "GarageLedger",
      "menuCategory": "Cicibyte Corp",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installer/sidebar.bmp",
      "installerHeader": "build/installer/header.bmp",
      "uninstallerSidebar": "build/installer/sidebar.bmp",
      "include": "installer/nsis/customInstaller.nsh",
      "installerLanguages": ["en_US"],
      "language": "1033",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RealMrNovember",
        "repo": "GarageLedger",
        "releaseType": "release"
      }
    ]
  }
}
